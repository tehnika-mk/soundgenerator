---
interface Props {
  /** Monospace eyebrow above the title, e.g. "GENERATOR / 01". */
  eyebrow?: string;
  title?: string;
  /** Optional badge text rendered next to the eyebrow. */
  badge?: string;
  /** Show the right-hand action slot. */
  class?: string;
}

const { eyebrow, title, badge, class: className = '' } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<section class={`panel ${className}`}>
  <header class="panel__head">
    <div class="flex items-center gap-2 min-w-0">
      {eyebrow && <span class="label">{eyebrow}</span>}
      {badge && <span class="badge badge--signal">{badge}</span>}
      {title && <span class="panel__title truncate">{title}</span>}
    </div>
    {hasActions && (
      <div class="flex items-center gap-2 flex-none">
        <slot name="actions" />
      </div>
    )}
  </header>
  <div class="panel__body">
    <slot />
  </div>
</section>

<style>
  .panel__title {
    font-size: 12.5px;
    color: var(--color-ink-2);
    font-weight: 500;
  }
</style>
