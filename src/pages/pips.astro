---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import { PIPS } from '../lib/audio/notes';
import { TOOLS } from '../data/tools';

const tool = TOOLS.find((t) => t.href === '/pips')!;

const related = TOOLS.filter((t) => ['/dtmf', '/noise-generator', '/alarm-generator', '/hearing-test'].includes(t.href));

const pipFrequencies = [
  { hz: 1000, label: '1000 Hz' },
  { hz: 800, label: '800 Hz' },
  { hz: 1500, label: '1500 Hz' },
];

const faqs = [
  {
    q: 'What are the pips, exactly?',
    a: 'The pips are the BBC\'s time signal: six short tones, the last one longer. Five pips are 0.1 s long and are spaced one second apart; the sixth, on the hour, is 0.5 s long. The rising long pip marks the exact top of the hour. They have been broadcast since 1924 and are generated from an atomic-clock reference, so within their one-second grid they are a genuine time signal rather than a decoration.',
  },
  {
    q: 'Why is the last pip longer?',
    a: 'Because one pip is reserved to mark the boundary. If all six were the same length and the same pitch, listeners could not tell which pip was the hour and whether the sequence had finished. The longer sixth pip makes the hour unambiguous and gives a clear instant to set your watch to - the start of that pip is the top of the hour. It also lets broadcasters identify the tone within the sequence.',
  },
  {
    q: 'What about leap seconds?',
    a: 'UTC is occasionally adjusted by one second so it tracks the Earth\'s rotation (the last was added in 2016). The BBC inserts a seventh pip for a positive leap second, after a one-second pause, so the sequence becomes six pips, a gap, then an extra pip. Removing a second (a negative leap second, which has never yet occurred) would drop a pip. For most of the year the six-pip pattern is unchanged.',
  },
  {
    q: 'Is this an accurate clock?',
    a: 'No. The tone frequencies are exact, but the timing depends entirely on your device clock and the AudioContext clock, which are synchronised to your operating system, not to an atomic reference. Use this page to hear and understand the signal, not to set a precision clock. On the hour it plays the pattern you asked for; the truth of the time is your computer\'s business, not this page\'s.',
  },
];
---

<Base
  title={tool.title}
  description={tool.meta}
  tool={tool}
  keywords={tool.keywords}
>
  <!-- ============================ Hero ============================ -->
  <div class="hero">
    <div class="hero__text">
      <p class="label label--accent">Signals &amp; telecom · the six-pip time signal</p>
      <h1>{tool.title}</h1>
      <p class="hero__lead">
        The BBC-style time signal: five 1000 Hz pips one second apart and a longer sixth pip on the hour. Play
        it on demand, watch the countdown to the next hour, or leave it armed to sound automatically. The
        tones are scheduled against the audio clock, not a timer loop, so they stay even.
      </p>
    </div>
    <div class="hero__aside">
      <div class="notice notice--info">
        <span class="notice__icon" aria-hidden="true">i</span>
        <p class="notice__body">
          This is a demonstration, not an official time source. Accuracy is limited by your device clock, and
          the automatic pips only fire while this browser tab stays open.
        </p>
      </div>
    </div>
  </div>

  <!-- ========================= The pips ========================= -->
  <section class="panel" id="pips" aria-labelledby="pips-heading">
    <header class="panel__head">
      <div class="flex items-center gap-2">
        <span class="label" id="pips-heading">The pips</span>
        <span class="badge">six pips · BBC pattern</span>
      </div>
      <span class="badge badge--signal">1 kHz</span>
    </header>

    <div class="panel__body pips-body">
      <!-- Left column: play + settings -->
      <div class="stack">
        <div class="transport">
          <button class="btn btn--primary btn--play" type="button" data-pips="play">
            <span class="transport__glyph" aria-hidden="true">▶</span> Play the pips
          </button>
          <button class="btn" type="button" data-pips="export">Save WAV</button>
        </div>

        <div>
          <span class="label" id="pips-freq-label">Pip frequency</span>
          <div class="segmented" role="group" aria-labelledby="pips-freq-label">
            {
              pipFrequencies.map((freq) => (
                <button
                  class="segmented__item"
                  type="button"
                  data-pips="freq"
                  data-hz={freq.hz}
                  aria-pressed={freq.hz === 1000 ? 'true' : 'false'}
                >
                  {freq.label}
                </button>
              ))
            }
          </div>
          <p class="hint">1000 Hz is the BBC standard. Some other broadcasters use 800 Hz or 1500 Hz.</p>
        </div>

        <div class="ref-row">
          <button class="btn" type="button" data-pips="ref" aria-pressed="false">Play 1 kHz reference</button>
          <span class="mono ref-row__note">continuous sine · Play / Stop</span>
        </div>

        <div class="auto">
          <label class="auto__label">
            <input id="pips-auto" type="checkbox" />
            <span>Automatically play the pips on the hour</span>
          </label>
          <p class="hint">
            Off by default. When on, the tab must stay open and the machine awake - the browser suspends timers
            and audio in a backgrounded or sleeping tab, and the pips will be missed. The pattern is armed a few
            seconds before the hour and aligned to the audio clock.
          </p>
        </div>

        <p class="status mono" data-pips="status" role="status" aria-live="polite">
          Ready. Press play to hear the six pips.
        </p>
      </div>

      <!-- Right column: clock -->
      <div class="stack">
        <div class="clock">
          <span class="scope__tag">Local time</span>
          <p class="clock__time mono" data-pips="clock">--:--:--</p>
          <div class="clock__grid">
            <div class="stat"><p class="stat__k">To next hour</p><p class="stat__v" data-pips="countdown">--:--</p></div>
            <div class="stat"><p class="stat__k">Next hour at</p><p class="stat__v" data-pips="next">--:--:--</p></div>
          </div>
        </div>

        <div class="scope scope--wave">
          <span class="scope__tag">Oscilloscope · output</span>
          <canvas data-scope="wave"></canvas>
        </div>

        <div class="stat-grid">
          <div class="stat"><p class="stat__k">Short pip</p><p class="stat__v mono">{PIPS.short} s</p></div>
          <div class="stat"><p class="stat__k">Long pip</p><p class="stat__v mono">{PIPS.long} s</p></div>
          <div class="stat"><p class="stat__k">Spacing</p><p class="stat__v mono">1.0 s</p></div>
          <div class="stat"><p class="stat__k">Pips</p><p class="stat__v mono">6</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= Reference ========================= -->
  <div class="two-col">
    <Panel eyebrow="Reference" title="How the time signal works">
      <div class="prose-tech">
        <h2>The six-pip pattern</h2>
        <p>
          Five short pips are emitted at one-second intervals, then a sixth pip that starts exactly on the hour
          and lasts five times as long. The <strong>start</strong> of the final pip is the reference instant: it
          coincides with the top of the hour. The frequency is nominally 1000 Hz - a clean, easy-to-hear tone
          that cuts through programme audio without being shrill.
        </p>
        <h2>Why the last pip is longer</h2>
        <p>
          The lengthened sixth pip disambiguates the end of the sequence. With six identical pips there would be
          no way to tell, by ear alone, which pip marked the hour. The long pip gives a single, unmistakable
          instant to set a clock against.
        </p>
        <h2>The leap-second case</h2>
        <p>
          UTC is adjusted to follow the Earth's rotation. When a positive leap second is inserted the BBC adds a
          seventh pip after a one-second pause; a negative leap second, never yet required, would remove one.
        </p>
        <h2>Accuracy</h2>
        <p>
          Broadcast pips are generated from an atomic-clock reference, so their spacing and the hour mark are
          accurate to well under a millisecond at the transmitter. What you hear, and what this page can
          recreate, is limited by the network path and your own device clock.
        </p>
      </div>
    </Panel>

    <Panel eyebrow="FAQ" title="Questions people actually ask">
      <div class="faq">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </Panel>
  </div>

  <!-- ===================== Related tools ===================== -->
  <Panel eyebrow="More tools" title="Related generators and tests">
    <div class="card-grid">
      {related.map((item) => (
        <a class="card" href={item.href}>
          <p class="card__t">{item.title}</p>
          <p class="card__d">{item.tagline}</p>
        </a>
      ))}
    </div>
  </Panel>

  <script>
    import '../scripts/pips';
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
    gap: 20px;
    align-items: start;
    margin-bottom: 18px;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  .hero h1 { font-size: clamp(1.6rem, 3.2vw, 2.1rem); margin: 6px 0 8px; }
  .hero__lead { color: var(--color-ink-2); max-width: 68ch; margin: 0; font-size: 14.5px; }
  .notice__body { margin: 0; }

  .pips-body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 20px;
  }
  @media (max-width: 1000px) {
    .pips-body { grid-template-columns: minmax(0, 1fr); }
  }
  .stack { display: flex; flex-direction: column; gap: 14px; }
  .flex { display: flex; }

  .transport { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .transport__glyph { font-size: 9px; }

  .ref-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ref-row__note { font-size: 11px; color: var(--color-ink-4); }

  .auto {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
  }
  .auto__label { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--color-ink); }
  .auto__label input { accent-color: var(--color-signal); width: 15px; height: 15px; }

  .clock {
    position: relative;
    padding: 16px 14px 14px;
    background: #05070a;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }
  .clock__time {
    font-size: clamp(2rem, 7vw, 3rem);
    line-height: 1.05;
    color: var(--color-signal);
    letter-spacing: 0.02em;
    margin: 14px 0 12px;
  }
  .clock__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 1px; background: var(--color-line); border: 1px solid var(--color-line); border-radius: var(--radius-sm); overflow: hidden; }

  .status { font-size: 11.5px; color: var(--color-ink-3); margin: 0; min-height: 18px; }
  .status[data-kind='ok'] { color: var(--color-signal); }
  .status[data-kind='error'] { color: var(--color-danger); }
  .status[data-kind='warn'] { color: var(--color-warn); }
  .status[data-kind='idle'] { color: var(--color-ink-3); }

  .hint { margin: 7px 0 0; font-size: 11.5px; color: var(--color-ink-4); line-height: 1.7; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
    margin-top: 14px;
  }
  @media (max-width: 1000px) {
    .two-col { grid-template-columns: minmax(0, 1fr); }
  }

  .faq details { border-bottom: 1px solid var(--color-line); padding: 10px 0; }
  .faq details:first-of-type { padding-top: 0; }
  .faq summary {
    cursor: pointer;
    font-weight: 500;
    font-size: 13.5px;
    list-style: none;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before { content: "+"; font-family: var(--font-mono); color: var(--color-signal); flex: none; }
  .faq details[open] summary::before { content: "−"; }
  .faq details p { margin: 8px 0 0 18px; font-size: 13px; color: var(--color-ink-2); line-height: 1.65; }
</style>
