---
/**
 * Human-readable sitemap: every tool on the site, grouped, with a one-line
 * description each. Kept separate from the tool registry so it does not appear
 * in the navigation rail, but it is a normal indexable page and the footer
 * links to it.
 *
 * The machine-readable version is generated by @astrojs/sitemap at
 * /sitemap-index.xml, which only exists in a build (the dev server does not run
 * the integration), so it is described here in text rather than linked.
 */
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import { TOOLS, CATEGORY_ORDER, SITE, toolsByCategory } from '../data/tools';

const toolPages = TOOLS.filter((tool) => !tool.content && tool.href !== '/');
const contentPages = TOOLS.filter((tool) => tool.content);
const home = TOOLS.find((tool) => tool.href === '/')!;
const year = new Date().getFullYear();
---

<Base
  title="Sitemap"
  description="Every tool on Sound Generator in one place: tone and sweep generators, noise, binaural beats, tuning, metronome, DTMF, pips, hearing tests and audio file tools."
  keywords={['sitemap', 'all tools', 'sound generator index', 'tone generator tools']}
>
  <div class="hero">
    <div class="hero__text">
      <p class="label label--accent">Index · {TOOLS.length} pages</p>
      <h1>Sitemap</h1>
      <p class="hero__lead">
        Every page on {SITE.domain}, grouped by what it does. Start with the
        <a href="/">tone generator</a> if you just want a tone, or work down the list. Nothing here is hidden behind an
        account, and each tool runs in your browser.
      </p>
    </div>
    <div class="hero__aside">
      <div class="notice notice--info">
        <span class="notice__icon" aria-hidden="true">i</span>
        <p class="notice__body">
          Looking for the file search engines read? It is generated at build time as
          <code>/sitemap-index.xml</code> and advertised in <code>/robots.txt</code>.
        </p>
      </div>
    </div>
  </div>

  <Panel eyebrow="Start here" title="The main generator">
    <div class="card-grid">
      <a class="card" href={home.href}>
        <p class="card__t">{home.title}</p>
        <p class="card__d">{home.tagline}</p>
      </a>
    </div>
  </Panel>

  {
    CATEGORY_ORDER.map((category) => {
      const items = toolsByCategory(category).filter((tool) => tool.href !== '/' && !tool.content);
      if (items.length === 0) return null;
      return (
        <Panel eyebrow="Tools" title={category}>
          <div class="card-grid">
            {items.map((tool) => (
              <a class="card" href={tool.href}>
                <p class="card__t">{tool.title}</p>
                <p class="card__d">{tool.tagline}</p>
              </a>
            ))}
          </div>
        </Panel>
      );
    })
  }

  <Panel eyebrow="Reference" title="How it works and the small print">
    <div class="card-grid">
      {
        contentPages.map((tool) => (
          <a class="card" href={tool.href}>
            <p class="card__t">{tool.title}</p>
            <p class="card__d">{tool.tagline}</p>
          </a>
        ))
      }
    </div>
    <p class="sitemap-note">
      {toolPages.length} tool pages plus {contentPages.length} reference pages. Last built {year}. Set as one line:
      tones and sweeps are generated by the Web Audio API, downloads are rendered in your browser as 16-bit WAV files,
      and no audio you play or record is uploaded anywhere.
    </p>
  </Panel>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
    gap: 20px;
    align-items: start;
    margin-bottom: 18px;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  .hero h1 {
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    margin: 6px 0 8px;
  }
  .hero__lead {
    color: var(--color-ink-2);
    max-width: 68ch;
    margin: 0;
    font-size: 14.5px;
  }
  .notice__body { margin: 0; }
  .sitemap-note {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--color-line);
    font-size: 12px;
    color: var(--color-ink-4);
    max-width: 80ch;
  }
</style>
