---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import WaveIcon from '../components/WaveIcon.astro';
import { COMMON_PRESETS, octaveKeys, WAVEFORMS_LABEL } from '../lib/audio/notes';
import { TOOLS } from '../data/tools';

const tool = TOOLS.find((t) => t.href === '/')!;
const keys = octaveKeys(4, 440);
const waveformDescriptions: Record<string, string> = {
  sine: 'Flute-like, no harmonics. The reference for calibration.',
  square: 'Odd harmonics only. Hollow, buzzy, test-signal standard.',
  sawtooth: 'All harmonics. Bright and string-like.',
  triangle: 'Soft odd harmonics. Mellow, between sine and square.',
};

const related = TOOLS.filter((t) => ['/sweep-generator', '/noise-generator', '/instrument-tuning', '/hearing-test', '/multiple-tone-generator', '/subwoofer-test'].includes(t.href));

const faqs = [
  {
    q: 'How accurate is the tone?',
    a: 'The oscillator is generated by your browser’s Web Audio API at the device sample rate (typically 44.1 or 48 kHz). Frequency accuracy is limited only by the crystal in your sound card, which is normally better than 0.01%. The readout shows the exact frequency you entered plus the nearest musical note and the deviation in cents.',
  },
  {
    q: 'Why can’t I hear anything?',
    a: 'Check three things in order: the site level slider in the header, your system volume and the correct output device. Then check the frequency - anything above roughly 16 kHz is inaudible to most adults, and below about 30 Hz you will feel it more than hear it unless your speakers can reproduce it. Headphones make sub-bass and high frequencies far easier to hear.',
  },
  {
    q: 'Can I download the tone as a file?',
    a: 'Yes. The Save button renders the exact tone you have configured, in your browser, into a 16-bit PCM WAV file at 44.1 kHz - 1, 5, 10 or 30 seconds long - and downloads it. Nothing is uploaded; the file is built locally and works in any audio software.',
  },
  {
    q: 'How do I share a specific tone?',
    a: 'Every setting is in the URL. https://soundgenerator.app/?freq=432 plays 432 Hz on load, and https://soundgenerator.app/?freq=1000&waveform=square pre-selects the square wave as well. Use the Copy link button to grab the URL for the current settings.',
  },
];
---

<Base
  title={tool.title}
  description={tool.meta}
  tool={tool}
  keywords={tool.keywords}
>
  <!-- ============================ Hero ============================ -->
  <div class="hero">
    <div class="hero__text">
      <p class="label label--accent">Signal generator · 1 Hz – 20 kHz</p>
      <h1>Online Tone Generator</h1>
      <p class="hero__lead">
        Enter a frequency and press play. The tone is synthesised live by your browser with the Web Audio API - no
        plugin, no account, no upload - and stops the moment you tell it to. Sine, square, sawtooth and triangle
        waveforms, exact frequency entry, and a 16-bit WAV export of whatever you hear.
      </p>
    </div>
    <div class="hero__aside">
      <div class="notice">
        <span class="notice__icon" aria-hidden="true">!</span>
        <p class="notice__body">
          Pure tones at high volume can damage hearing and speakers. Start with the header level low, especially
          before testing high frequencies or subwoofer settings. The limiter prevents digital clipping, not loud
          playback.
        </p>
      </div>
    </div>
  </div>

  <!-- ======================= Generator rig ======================= -->
  <section class="panel generator" id="generator" data-tone-generator aria-labelledby="generator-heading">
    <header class="panel__head">
      <div class="flex items-center gap-2">
        <span class="label" id="generator-heading">Generator</span>
        <span class="badge">Web Audio</span>
      </div>
      <div class="flex items-center gap-2">
        <button class="btn btn--ghost btn--sm" type="button" data-tg="share">Copy link</button>
      </div>
    </header>

    <div class="panel__body generator__body">
      <!-- Left: frequency control -->
      <div class="stack">
        <div>
          <label class="label" for="freq-input">Frequency (Hz)</label>
          <div class="freq-row">
            <input
              id="freq-input"
              class="input input--readout mono"
              data-tg="freq"
              type="text"
              inputmode="decimal"
              value="440"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="freq-help"
            />
            <div class="freq-row__note">
              <span class="readout freq-row__pitch" data-tg="note">A4</span>
              <span class="mono freq-row__cents" data-tg="cents">in tune</span>
            </div>
          </div>
          <p class="hint" id="freq-help">
            <span class="kbd">↑</span> <span class="kbd">↓</span> nudge ±1 Hz ·
            <span class="kbd">Shift</span> + arrows ±10 Hz · <span class="kbd">Enter</span> play ·
            <span class="kbd">Esc</span> stop
          </p>
        </div>

        <div class="nudge">
          <button class="btn btn--sm" type="button" data-nudge="-10">−10</button>
          <button class="btn btn--sm" type="button" data-nudge="-1">−1</button>
          <button class="btn btn--sm" type="button" data-nudge="1">+1</button>
          <button class="btn btn--sm" type="button" data-nudge="10">+10</button>
          <span class="nudge__sep" aria-hidden="true"></span>
          <button class="btn btn--sm" type="button" data-nudge="/2">÷2</button>
          <button class="btn btn--sm" type="button" data-nudge="x2">×2</button>
          <label class="nudge__select">
            <span class="visually-hidden">Reference pitch for the note readout</span>
            <select class="input input--compact mono" id="a4-reference">
              <option value="440">A4 = 440</option>
              <option value="432">A4 = 432</option>
              <option value="435">A4 = 435</option>
              <option value="415">A4 = 415</option>
            </select>
          </label>
        </div>

        <div class="slider-wrap">
          <label class="visually-hidden" for="freq-slider">Frequency slider (logarithmic)</label>
          <input
            class="slider"
            id="freq-slider"
            type="range"
            min="0"
            max="1000"
            step="1"
            value="418"
            aria-valuetext="440 hertz"
          />
          <div class="slider-scale mono">
            <span>20 Hz</span><span>100</span><span>1 k</span><span>10 k</span><span>20 kHz</span>
          </div>
        </div>

        <div class="transport">
          <button class="btn btn--primary btn--play" type="button" data-tg="play" aria-pressed="false">
            <span class="transport__glyph" aria-hidden="true">▶</span> Play
          </button>
          <button class="btn btn--stop" type="button" data-tg="stop" aria-pressed="false" disabled>
            <span class="transport__glyph" aria-hidden="true">■</span> Stop
          </button>
          <div class="transport__export">
            <button class="btn" type="button" data-tg="export">Save WAV</button>
            <label class="visually-hidden" for="export-length">Clip length</label>
            <select class="input input--compact mono" id="export-length" data-tg="export-seconds">
              <option value="1">1 s</option>
              <option value="5">5 s</option>
              <option value="10" selected>10 s</option>
              <option value="30">30 s</option>
            </select>
          </div>
        </div>

        <p class="status mono" data-tg="status" role="status" aria-live="polite">Ready. Press play to sound the tone.</p>

        <!-- Waveform -->
        <div>
          <span class="label" id="waveform-label">Waveform</span>
          <div class="waveforms" role="group" aria-labelledby="waveform-label">
            {
              (
                [
                  ['sine', 'Sine'],
                  ['square', 'Square'],
                  ['sawtooth', 'Sawtooth'],
                  ['triangle', 'Triangle'],
                ] as const
              ).map(([value, label]) => (
                <button
                  class="waveform"
                  type="button"
                  data-tg="waveform"
                  data-value={value}
                  aria-pressed={value === 'sine' ? 'true' : 'false'}
                  title={waveformDescriptions[value]}
                >
                  <WaveIcon waveform={value} size={26} />
                  <span class="waveform__label">{label}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Right: analysis -->
      <div class="stack">
        <div class="scope scope--wave">
          <span class="scope__tag">Oscilloscope · output</span>
          <canvas data-scope="wave"></canvas>
        </div>
        <div class="scope scope--spec">
          <span class="scope__tag">Spectrum · 0 – 20 kHz</span>
          <canvas data-scope="spectrum" data-peak="true"></canvas>
        </div>

        <div class="stat-grid">
          <div class="stat"><p class="stat__k">Wavelength</p><p class="stat__v" data-stat="wavelength">0.78 m</p></div>
          <div class="stat"><p class="stat__k">Period</p><p class="stat__v" data-stat="period">2.273 ms</p></div>
          <div class="stat"><p class="stat__k">MIDI</p><p class="stat__v" data-stat="midi">69</p></div>
          <div class="stat"><p class="stat__k">Octave</p><p class="stat__v" data-stat="octave">4</p></div>
          <div class="stat"><p class="stat__k">Nearest note</p><p class="stat__v" data-stat="nearest">A4 · 440 Hz</p></div>
          <div class="stat"><p class="stat__k">Deviation</p><p class="stat__v" data-stat="cents">exact</p></div>
        </div>
      </div>
    </div>

    <!-- Presets -->
    <div class="panel__body panel__body--tight hairline presets">
      <span class="label presets__label">Presets</span>
      <div class="presets__grid">
        {
          COMMON_PRESETS.map((preset) => (
            <button class="preset" type="button" data-tg="preset" data-freq={preset.hz} title={preset.note}>
              <span class="preset__hz mono">{preset.label}</span>
              <span class="preset__note">{preset.note}</span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Piano -->
    <div class="panel__body panel__body--tight hairline">
      <div class="keys-head">
        <span class="label">Note keys · C4 – E5 · press and hold</span>
        <span class="mono keys-head__hint">A4 = 440 Hz equal temperament</span>
      </div>
      <div class="keys" role="group" aria-label="Note keys">
        {
          keys.map((key) => (
            <button
              class="key"
              type="button"
              data-tg="key"
              data-freq={key.freq}
              data-black={String(key.black)}
              aria-pressed="false"
              aria-label={`${key.label} ${key.freq} hertz`}
            >
              <span class="key__name">{key.label}</span>
              <span class="key__hz">{key.freq < 1000 ? key.freq.toFixed(0) : (key.freq / 1000).toFixed(2)}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================= Reference ========================= -->
  <div class="two-col">
    <Panel eyebrow="Reference" title="What each waveform is for">
      <table class="table-tech">
        <thead>
          <tr><th>Waveform</th><th>Harmonics</th><th>Sound &amp; typical use</th></tr>
        </thead>
        <tbody>
          {
            (
              [
                ['sine', 'None', 'The purest tone. Calibration, hearing tests, subwoofer and room measurements.'],
                ['square', 'Odd only (1/n)', 'Hollow and buzzy. Retro game sounds, logic and clock testing.'],
                ['sawtooth', 'All (1/n)', 'Bright, string-like. Synthesiser strings and brass.'],
                ['triangle', 'Odd only (1/n²)', 'Mellow and soft. Flute-like leads, gentle test tones.'],
              ] as const
            ).map(([name, harmonics, use]) => (
              <tr>
                <td class="mono"><WaveIcon waveform={name} size={30} /> {WAVEFORMS_LABEL[name]}</td>
                <td class="mono">{harmonics}</td>
                <td>{use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="hint">
        A pure sine wave contains energy at exactly one frequency. The other three waveforms add harmonics at whole
        multiples of the fundamental, which is why they sound brighter - and why they read as a comb of peaks in the
        spectrum display above.
      </p>
    </Panel>

    <Panel eyebrow="FAQ" title="Questions people actually ask">
      <div class="faq">
        {
          faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </Panel>
  </div>

  <!-- ==================== Long-form content ==================== -->
  <Panel eyebrow="Guide" title="How to use the tone generator">
    <div class="prose-tech">
      <h2>Setting an exact frequency</h2>
      <p>
        Type the number you want (whole hertz or decimals, for example <code>146.83</code>) and press
        <span class="kbd">Enter</span>. While a tone is playing, editing the field retunes it live - no need to stop
        and start. The arrow keys step by 1 Hz, or by 10 Hz with <span class="kbd">Shift</span> held, which is the
        fastest way to walk a frequency band by ear.
      </p>
      <h2>Working with the slider</h2>
      <p>
        The slider is logarithmic, matching how we hear: equal slider distances are equal musical intervals. The
        lower half of the travel covers 20 Hz – 640 Hz, which is why small movements down there matter. The
        <code>÷2</code> and <code>×2</code> buttons jump exactly one octave, and the note keys play equal-tempered
        pitches directly.
      </p>
      <h2>Saving a tone</h2>
      <p>
        <strong>Save WAV</strong> renders the current frequency and waveform offline in your browser and downloads a
        16-bit PCM file at 44.1 kHz, starting and ending on a zero crossing so there are no clicks at the edges. Use
        it when you need a file for a phone, a test rig, a DAW or a device that will not run Web Audio.
      </p>
      <h2>Sharing an exact tone</h2>
      <p>
        The address bar is the preset store. <code>?freq=432</code> loads 432 Hz,
        <code>?waveform=square</code> pre-selects the square wave, and they combine:
        <code>?freq=1000&amp;waveform=sawtooth</code>. <strong>Copy link</strong> builds that URL for whatever you
        have set right now.
      </p>
    </div>
  </Panel>

  <!-- ===================== Related tools ===================== -->
  <Panel eyebrow="More tools" title="Related generators and tests">
    <div class="card-grid">
      {
        related.map((item) => (
          <a class="card" href={item.href}>
            <p class="card__t">{item.title}</p>
            <p class="card__d">{item.tagline}</p>
          </a>
        ))
      }
    </div>
  </Panel>

  <script>
    import '../scripts/home';
  </script>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
    gap: 20px;
    align-items: start;
    margin-bottom: 18px;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
  }
  .hero h1 {
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    margin: 6px 0 8px;
  }
  .hero__lead {
    color: var(--color-ink-2);
    max-width: 68ch;
    margin: 0;
    font-size: 14.5px;
  }
  .notice__body { margin: 0; }

  .generator__body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 20px;
  }
  @media (max-width: 1000px) {
    .generator__body { grid-template-columns: minmax(0, 1fr); }
  }

  .stack { display: flex; flex-direction: column; gap: 14px; }

  .freq-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    margin-top: 6px;
  }
  .freq-row .input--readout {
    flex: 1 1 auto;
    font-size: 30px;
    letter-spacing: -0.02em;
    padding: 8px 12px;
  }
  .freq-row__note {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 1px;
    min-width: 92px;
    padding: 2px 10px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel-2);
  }
  .freq-row__pitch { font-size: 20px; }
  .freq-row__cents { font-size: 10.5px; color: var(--color-ink-3); }

  .hint {
    margin: 7px 0 0;
    font-size: 11.5px;
    color: var(--color-ink-4);
    line-height: 1.7;
  }

  .nudge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .nudge__sep {
    width: 1px;
    height: 18px;
    background: var(--color-line);
    margin: 0 3px;
  }
  .nudge__select { margin-left: auto; }
  .input--compact {
    min-height: 30px;
    padding: 3px 8px;
    font-size: 12px;
    width: auto;
  }

  .slider-wrap { margin-top: 2px; }
  .slider-scale {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--color-ink-4);
    margin-top: -2px;
  }

  .transport {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-top: 2px;
  }
  .transport__glyph { font-size: 9px; }
  .transport__export { display: flex; gap: 6px; align-items: center; }
  .transport__export select { min-width: 74px; }

  .status {
    font-size: 11.5px;
    color: var(--color-ink-3);
    margin: 0;
    min-height: 18px;
  }
  .status[data-kind='ok'] { color: var(--color-signal); }
  .status[data-kind='error'] { color: var(--color-danger); }
  .status[data-kind='warn'] { color: var(--color-warn); }

  .waveforms {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin-top: 6px;
  }
  @media (max-width: 480px) {
    .waveforms { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .waveform {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 6px 8px;
    background: var(--color-void);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    cursor: pointer;
  }
  .waveform:hover { border-color: var(--color-line-3); color: var(--color-ink); }
  .waveform[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--color-signal) 48%, transparent);
    background: color-mix(in oklab, var(--color-signal) 12%, var(--color-panel-3));
    color: var(--color-signal);
  }
  .waveform__label { font-size: 11.5px; font-weight: 500; }

  .presets { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .presets__label { padding-top: 4px; }
  .presets__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1 1 320px;
  }
  .preset {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 4px 9px;
    background: var(--color-panel-2);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-2);
    cursor: pointer;
    font-size: 12px;
  }
  .preset:hover { border-color: var(--color-signal); color: var(--color-signal); }
  .preset__hz { font-size: 12px; }
  .preset__note { font-size: 10px; color: var(--color-ink-4); }
  .preset:hover .preset__note { color: color-mix(in oklab, var(--color-signal) 70%, var(--color-ink-4)); }

  .keys-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .keys-head__hint { font-size: 10.5px; color: var(--color-ink-4); }
  .key__name { display: block; }
  .key__hz { display: block; font-size: 9.5px; color: var(--color-ink-4); }
  .key[aria-pressed='true'] .key__hz { color: #04231b; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
    margin-top: 14px;
  }
  @media (max-width: 1000px) {
    .two-col { grid-template-columns: minmax(0, 1fr); }
  }
  .two-col :global(.panel + .panel) { margin-top: 0; }

  .faq details {
    border-bottom: 1px solid var(--color-line);
    padding: 10px 0;
  }
  .faq details:first-of-type { padding-top: 0; }
  .faq summary {
    cursor: pointer;
    font-weight: 500;
    font-size: 13.5px;
    list-style: none;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::before {
    content: "+";
    font-family: var(--font-mono);
    color: var(--color-signal);
    flex: none;
  }
  .faq details[open] summary::before { content: "−"; }
  .faq details p {
    margin: 8px 0 0 18px;
    font-size: 13px;
    color: var(--color-ink-2);
    line-height: 1.65;
  }
</style>
