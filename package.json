{
  "name": "soundgenerator-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sound Generator — free online tone generator, sweep, noise, binaural beats and audio test tools built on the Web Audio API.",
  "scripts": {
    "dev": "astro dev --port 4321",
    "start": "astro dev --port 4321",
    "build": "astro build && node tools/inject_schema.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node tools/verify_dist.mjs",
    "qa": "node tools/browser_qa.mjs",
    "audio-test": "node tools/audio_tests.mjs",
    "og": "node tools/make_og.mjs",
    "seo": "node tools/seo_audit.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4"
  }
}
